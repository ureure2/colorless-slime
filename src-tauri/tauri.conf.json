{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "무색슬라임",
  "version": "0.1.0",
  "identifier": "io.github.musaekslime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/culture-note"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "무색슬라임",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "두 개의 작은 AI를 가르치고 관찰하는 배양 노트",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
